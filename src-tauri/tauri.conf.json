{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "npp-x",
  "version": "0.1.4",
  "identifier": "com.nppx.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "npp-x",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFQzBGQzhGRkZDOTM2OUEKUldTYU5zbi9qL3pBRHFzcmYwdmp4WEc2NHR2YUQ1TzMzaVJjOWlEWkQ1SGFCMVc4UlNSTTYrTkwK",
      "endpoints": [
        "https://github.com/arun-prasad-t/npp-x/releases/latest/download/latest.json"
      ]
    }
  }
}
